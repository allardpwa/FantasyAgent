# Yahoo app credentials - create at https://developer.yahoo.com/apps/create/
# App type: Web Application. Permissions: Fantasy Sports -> Read/Write
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

# Must match the Redirect URI you entered on the Yahoo app exactly.
# Yahoo requires https. The page does not need to exist - the agent reads the
# ?code= parameter out of the URL you get redirected to.
YAHOO_REDIRECT_URI=https://localhost:8080/callback
