# Yahoo app credentials - create at https://developer.yahoo.com/apps/create/
# App type: Web Application. API Permissions: Fantasy Sports -> Read/Write
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

# Must match the Redirect URI on the Yahoo app EXACTLY - trailing slash included.
# The page never has to exist: it will 404, and you copy the ?code= value out of
# the address bar. Try localhost first (nothing leaves your machine); if Yahoo
# rejects it, use a path on a domain you own, e.g.
#   https://www.taeron.ca/oauth/yahoo-callback
YAHOO_REDIRECT_URI=https://localhost:8080/callback
